[Unit]
Description=Thur VTL Daemon
Documentation=https://github.com/metebalci/thur
After=network.target

# Restart policy: limit restart attempts to prevent infinite loops
# Maximum 5 restart attempts within 300 seconds (5 minutes)
# After hitting the limit, service enters failed state
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/thurvtld --config /etc/thurvtl/thurvtl.yaml
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=thurvtld

# Optional daemon environment file. Leading `-` makes it
# optional — if /etc/thurvtl/thurvtl.env doesn't exist the unit
# starts anyway (useful when every env var comes from elsewhere,
# e.g. cloud VM instance identity). Holds cloud credentials,
# ${ENV_VAR} secrets referenced from thurvtl.yaml (alerting
# webhook tokens, SMTP passwords, etc.), and any future env-var
# feature flags. 0640 root:thurvtl. See README.md § Configuring
# cloud credentials for systemd.
EnvironmentFile=-/etc/thurvtl/thurvtl.env

User=thurvtl
Group=thurvtl

# Provision /run/thurvtl/ at boot for the admin Unix socket
# (`/run/thurvtl/admin.sock`). systemd creates the directory
# owned by User/Group with the requested mode and tears it down
# on stop. Mode 0750 lets the daemon (owner) and any operator in
# the `thurvtl` group `connect()` to the socket; non-members
# get EACCES at the directory walk before they ever reach the
# socket itself. The CLI client connects here unconditionally;
# decoupling the socket path from the daemon's `data_dir` is what
# lets daemon-routed CLI commands run without reading the
# 0640 conffile.
RuntimeDirectory=thurvtl
RuntimeDirectoryMode=0750

# iSCSI listens on the privileged port 3260. Grant only that capability
# to the unprivileged thurvtl user, restrict the bounding set, and
# drop everything else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/thurvtl

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
