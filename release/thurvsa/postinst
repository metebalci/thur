#!/bin/sh
# thurvsa postinst — runs after .deb install/upgrade.
#
# Notably this does NOT enable or start the daemon. The daemon needs
# /etc/thurvsa/thurvsa.yaml filled in (at least one cloud backend
# uncommented) before it can usefully run; auto-enable would just
# produce noisy failed-unit logs. Operator runs `systemctl enable
# --now thurvsad` after configuring.
set -e

case "$1" in
    configure)
        # Create system user/group if missing
        if ! getent group thurvsa >/dev/null; then
            groupadd --system thurvsa
        fi
        if ! getent passwd thurvsa >/dev/null; then
            useradd --system \
                    --gid thurvsa \
                    --home-dir /var/lib/thurvsa \
                    --shell /usr/sbin/nologin \
                    --comment "Thur VSA daemon" \
                    thurvsa
        fi

        # Create the daemon's data dir. cargo-deb only creates parent
        # dirs for files it installs and we ship nothing under
        # /var/lib/thurvsa/, so postinst is the only chance to lay it
        # down. systemd's `ReadWritePaths=/var/lib/thurvsa` in the
        # unit refuses to start the daemon without it. `install -d`
        # is idempotent on upgrade.
        install -d -m 0750 -o thurvsa -g thurvsa /var/lib/thurvsa

        # Conffile + cloud-credentials env file — readable by the
        # daemon's group (thurvsa), opaque to other users. The
        # packaged mode is 0640, but cargo-deb installs files
        # root:root by default; the daemon runs as thurvsa and
        # would hit EACCES without the chown. Idempotent: re-runs
        # on every upgrade reset operator-fiddled perms back to
        # the intended root:thurvsa 0640.
        if [ -f /etc/thurvsa/thurvsa.yaml ]; then
            chown root:thurvsa /etc/thurvsa/thurvsa.yaml
            chmod 0640 /etc/thurvsa/thurvsa.yaml
        fi
        if [ -f /etc/thurvsa/thurvsa.env ]; then
            chown root:thurvsa /etc/thurvsa/thurvsa.env
            chmod 0640 /etc/thurvsa/thurvsa.env
        fi

        # First-install hint (only on configure-from-no-prior-version)
        if [ -z "$2" ]; then
            cat <<'EOF'

Thur VSA installed. To get running:
  1. Edit /etc/thurvsa/thurvsa.yaml — minimal starter; data_dir
     defaults to /var/lib/thurvsa, you just uncomment a
     cloud.backends entry. Full reference for every key:
     /usr/share/doc/thurvsa/thurvsa.defaults.yaml
  2. sudo systemctl enable --now thurvsad
  3. thurvsa volume create myvol --size 100G
     (creates an iSCSI LUN backed by the configured backend;
      target IQN is iqn.2025-10.com.metebalci:thurvsa on port 3260)

To use thurvsa against the running daemon, add operator users to
the thurvsa group (the admin socket /run/thurvsa/admin.sock is
mode 0660 and owned by thurvsa:thurvsa):
    sudo usermod -aG thurvsa <user>     # log out / log back in to apply

Logs: sudo journalctl -u thurvsad -f
EOF
        elif [ -f /run/thurvsa.upgrade-stopped ]; then
            # Upgrade over a running daemon: prerm stopped it, and the
            # package does not restart it. Tell the operator.
            rm -f /run/thurvsa.upgrade-stopped
            cat <<'EOF'

Thur VSA upgraded. The daemon was running and has been stopped for the
upgrade; it is NOT restarted automatically. Start it when ready:
  sudo systemctl start thurvsad
EOF
        fi
        ;;
esac

# cargo-deb injects the systemd unit registration here (daemon-reload,
# *not* enable/start — that's controlled by the systemd-units metadata
# block in thurvsa/Cargo.toml).
#DEBHELPER#

exit 0
